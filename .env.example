# Base de données : PostgreSQL Supabase (Project Settings > Database > Connection string).
#   DATABASE_URL = « Transaction pooler » (port 6543) : utilisée par le site (Netlify). Garder ?pgbouncer=true
#   DIRECT_URL   = « Direct connection » ou « Session pooler » (port 5432) : utilisée par prisma db push / db:setup
DATABASE_URL="postgresql://postgres.PROJECT_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:MOT_DE_PASSE@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Stockage des images, vidéos et documents clients : Supabase Storage (Project Settings > API).
# Créer deux buckets : « uploads » (PUBLIC) et « documents » (PRIVÉ). Sans ces variables, les fichiers vont sur le disque local.
# SUPABASE_SERVICE_ROLE_KEY est un secret serveur : ne jamais la préfixer par NEXT_PUBLIC_.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Secret de signature des sessions admin (32+ caractères aléatoires). Générer : openssl rand -base64 48
AUTH_SECRET="change-me-with-a-long-random-string-at-least-32-chars"

# URL publique du site
NEXT_PUBLIC_SITE_URL="https://qs2h.fr"

# Compte administrateur initial (utilisé par `npm run db:seed`, à changer à la première connexion)
ADMIN_EMAIL="admin@qs2h.fr"
ADMIN_PASSWORD="ChangeMoi-Maintenant-2026!"

# Emails transactionnels (Resend) — optionnel en local
RESEND_API_KEY=""
MAIL_FROM="QS2H <noreply@qs2h.fr>"
MAIL_TO="contact@qs2h.fr"

# Anti-spam Cloudflare Turnstile — optionnel en local (clés de test : https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Capture automatique des réalisations (back-office > Réalisations > « Capturer depuis l'URL »)
# En local ou sur un serveur avec Chromium (npx playwright install chromium) : rien à configurer.
# Sur Vercel (pas de navigateur) : déployez worker/capture-server.ts (Docker) et renseignez :
CAPTURE_WORKER_URL=""
CAPTURE_WORKER_TOKEN=""
# Navigateur utilisé pour la capture en local (chrome, msedge…) : facultatif
CAPTURE_BROWSER_CHANNEL=""
# Scores Lighthouse réels via Google PageSpeed Insights (clé gratuite recommandée, sinon quota partagé)
PSI_API_KEY=""

# Assistant QS2H (chatbot) : sans clé, moteur à règles sur les données du site ; avec clé, réponses rédigées par Claude
# (limitées à la même base de connaissances). CHATBOT_MODEL facultatif (par défaut : claude-haiku-5-5).
ANTHROPIC_API_KEY=""
CHATBOT_MODEL=""

# Double authentification obligatoire pour le propriétaire (recommandé en production). Désactivée par défaut.
ADMIN_REQUIRE_2FA="false"

# Connexion Google de l'espace client (optionnel). Console Google Cloud > APIs et services > Identifiants > ID client OAuth (application Web).
# URI de redirection autorisée : <NEXT_PUBLIC_SITE_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
