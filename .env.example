# Base de données : SQLite en local. En production, passer à PostgreSQL (Neon, Supabase…) :
#   1) prisma/schema.prisma -> provider = "postgresql"
#   2) DATABASE_URL="postgresql://user:pass@host:5432/qs2h?sslmode=require"
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions admin (32+ caractères aléatoires). Générer : openssl rand -base64 48
AUTH_SECRET="change-me-with-a-long-random-string-at-least-32-chars"

# URL publique du site
NEXT_PUBLIC_SITE_URL="https://qs2h.fr"

# Compte administrateur initial (utilisé par `npm run db:seed`, à changer à la première connexion)
ADMIN_EMAIL="admin@qs2h.fr"
ADMIN_PASSWORD="ChangeMoi-Maintenant-2026!"

# Emails transactionnels (Resend) — optionnel en local
RESEND_API_KEY=""
MAIL_FROM="QS2H <noreply@qs2h.fr>"
MAIL_TO="contact@qs2h.fr"

# Anti-spam Cloudflare Turnstile — optionnel en local (clés de test : https://developers.cloudflare.com/turnstile/troubleshooting/testing/)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Capture automatique des réalisations (back-office > Réalisations > « Capturer depuis l'URL »)
# En local ou sur un serveur avec Chromium (npx playwright install chromium) : rien à configurer.
# Sur Vercel (pas de navigateur) : déployez worker/capture-server.ts (Docker) et renseignez :
CAPTURE_WORKER_URL=""
CAPTURE_WORKER_TOKEN=""
# Scores Lighthouse réels via Google PageSpeed Insights (clé gratuite recommandée, sinon quota partagé)
PSI_API_KEY=""
